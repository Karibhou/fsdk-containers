{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "schedule": [
    "after 2am and before 6am"
  ],
  "ignorePaths": [
    "elements/curl/curl-runtime.bst",
    "elements/curl/curl-stack.bst",
    "elements/falco/falco-stack.bst",
    "elements/falco/falco.bst",
    "elements/go-md2man/go-md2man.bst",
    "elements/go/go-runtime.bst",
    "elements/go/go-stack.bst",
    "elements/kubestellar-hive/hive-bin.bst",
    "elements/kubestellar-hive/kubestellar-hive-stack.bst",
    "elements/kubestellar-hive/libwebsockets.bst",
    "elements/kubestellar-hive/ttyd.bst",
    "elements/mariadb/mariadb-runtime.bst",
    "elements/mariadb/mariadb-stack.bst",
    "elements/mariadb/mariadb.bst",
    "elements/nginx/nginx-runtime.bst",
    "elements/nginx/nginx-stack.bst",
    "elements/nginx/nginx.bst",
    "elements/postgres/postgres-runtime.bst",
    "elements/postgres/postgres-stack.bst",
    "elements/postgres/postgres.bst",
    "elements/valkey/valkey-runtime.bst",
    "elements/valkey/valkey-stack.bst",
    "elements/valkey/valkey.bst",
    "elements/volcano/volcano-runtime.bst",
    "elements/volcano/volcano-stack.bst",
    "elements/volcano/volcano.bst"
  ],
  "customManagers": [
    {
      "description": "BuildStream elements: any value annotated with a '# renovate:' comment on the preceding line. Covers `<tool>_version:` variables, `track:` pins and pinned tarball URLs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.bst$/",
        "/^Justfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[^\\n]*?[:=]\\s*\"?(?<currentValue>[\\w][\\w.+-]*)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Pinned Python dependencies for the catalog / verify workflows. The required validate check rejects stale hashes.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/requirements/.*\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[A-Za-z0-9][A-Za-z0-9._-]*)==(?<currentValue>[0-9][A-Za-z0-9.+_-]*)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "customDatasources": {
    "qemu-downloads": {
      "description": "qemu-img tracks the release tarballs on download.qemu.org, not the GitLab tags. Upstream creates the vX.Y.Z tag before the tarball is published, so a gitlab-tags proposal makes `bst source track` fail with HTTP 404 until the tarball lands. Scraping the download index only ever proposes a version that can actually be fetched.",
      "defaultRegistryUrlTemplate": "https://download.qemu.org/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "BuildStream source updates: refresh-bst-refs pushes updated source refs; required checks validate the PR, and Build images runs after merge. Hive review of Renovate updates is advisory.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "**/*.bst",
        "Justfile"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "buildstream"
      ]
    },
    {
      "description": "Pinned PyPI packages: Renovate changes versions but not hashes. The required validate check rejects stale hashes; regenerate them as described in docs/skills/ci-tooling/SKILL.md.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "python"
      ]
    },
    {
      "description": "kubectl follows the Kubernetes release cadence; skip pre-releases.",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "ignoreUnstable": true
    },
    {
      "description": "Renovate waits three days after a third-party GitHub Actions release before automerging; Hive's trusted-bot review remains advisory.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!/^(projectbluefin)\\//"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Project Bluefin GitHub Actions updates can be automerged by Renovate immediately.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^projectbluefin\\//"],
      "minimumReleaseAge": null,
      "automerge": true
    },
    {
      "description": "Major GitHub Actions updates are not automerged by Renovate; Hive's trusted-bot review remains advisory.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
